{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minions-land.github.io/Magenta-CLI/catalog/v1/schema.json",
  "title": "Magenta public model catalog, version 1",
  "description": "Either the whole catalog (models.json, with `providers`) or one provider's slice (providers/<id>.json, with `provider` and `models`). `digest` is sha256 over JSON.stringify of `providers` or `models` as parsed.",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "digest"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "models": {
      "$ref": "#/$defs/models"
    },
    "providers": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/models"
      }
    }
  },
  "oneOf": [
    {
      "required": [
        "provider",
        "models"
      ]
    },
    {
      "required": [
        "providers"
      ]
    }
  ],
  "$defs": {
    "models": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/model"
      }
    },
    "model": {
      "type": "object",
      "required": [
        "id",
        "name",
        "api",
        "provider",
        "baseUrl",
        "reasoning",
        "input",
        "cost",
        "contextWindow",
        "maxTokens"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "api": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "baseUrl": {
          "type": "string"
        },
        "reasoning": {
          "type": "boolean"
        },
        "input": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "text",
              "image"
            ]
          }
        },
        "cost": {
          "type": "object",
          "required": [
            "input",
            "output",
            "cacheRead",
            "cacheWrite"
          ],
          "properties": {
            "input": {
              "type": "number"
            },
            "output": {
              "type": "number"
            },
            "cacheRead": {
              "type": "number"
            },
            "cacheWrite": {
              "type": "number"
            }
          }
        },
        "contextWindow": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maxContextWindow": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maxTokens": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  }
}
